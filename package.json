{
  "name": "@jchpro/nest",
  "version": "0.0.0",
  "description": "Nest.js libraries monorepo",
  "author": "https://github.com/jchpro",
  "private": true,
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/jchpro/nest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchpro/nest.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:libs",
    "build:libs": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "pretype-check": "npm run build:libs",
    "lint": "eslint \"libs/**/*.ts\" \"apps/**/*.ts\" --fix",
    "lint:check": "eslint \"libs/**/*.ts\" \"apps/**/*.ts\"",
    "format": "prettier --write \"libs/**/*.ts\" \"apps/**/*.ts\"",
    "test": "vitest run",
    "pretest": "npm run build:libs",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify:libs": "npm run build:libs && node scripts/verify-libs.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "start:example": "npm run build && npm run start --workspace apps/example-app",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.22.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.1",
    "bcrypt": "^6.0.0",
    "case-anything": "^3.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.0",
    "nestjs-i18n": "^10.8.5",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "nestjs-i18n": {
      "chokidar": "^4.0.3"
    }
  },
  "allowScripts": {
    "bcrypt": true,
    "esbuild": true,
    "@swc/core": true,
    "@scarf/scarf": false
  },
  "workspaces": [
    "libs/common",
    "libs/config",
    "libs/i18n",
    "libs/mongoose",
    "apps/example-app"
  ]
}

{
  "name": "@jchpro/nest-example-app",
  "version": "0.0.0",
  "description": "Example Nest.js app using the @jchpro/nest-* libraries",
  "private": true,
  "type": "module",
  "license": "LGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "create-migration": "mongo-migrate-create src/migrations src/app.migrations.ts @jchpro/nest-mongoose"
  },
  "dependencies": {
    "@jchpro/nest-common": "*",
    "@jchpro/nest-config": "*",
    "@jchpro/nest-mongoose": "*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "mongoose": "^8.24.4",
    "morgan": "^1.12.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.13.6"
  }
}

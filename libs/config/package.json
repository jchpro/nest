{
  "name": "@jchpro/nest-config",
  "version": "1.0.0",
  "description": "Config loading utility for Nest.js",
  "keywords": [
    "nest.js",
    "config",
    "environment"
  ],
  "type": "module",
  "private": false,
  "author": "https://github.com/jchpro",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/jchpro/nest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchpro/nest.git",
    "directory": "libs/config"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "readme.md",
    "changelog.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3"
  }
}

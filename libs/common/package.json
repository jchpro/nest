{
  "name": "@jchpro/nest-common",
  "version": "1.0.0",
  "description": "Common parts for the Nest.js apps",
  "keywords": [
    "nest.js",
    "utilities",
    "node"
  ],
  "type": "module",
  "private": false,
  "author": "https://github.com/jchpro",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/jchpro/nest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchpro/nest.git",
    "directory": "libs/common"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi/index.js"
    },
    "./request-logger": {
      "types": "./dist/request-logger/index.d.ts",
      "default": "./dist/request-logger/index.js"
    },
    "./throttling": {
      "types": "./dist/throttling/index.d.ts",
      "default": "./dist/throttling/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "readme.md",
    "changelog.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "bcrypt": "^5.1.1 || ^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "morgan": "^1.10.1",
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "@nestjs/throttler": {
      "optional": true
    },
    "bcrypt": {
      "optional": true
    },
    "morgan": {
      "optional": true
    }
  }
}
